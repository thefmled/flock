# ─────────────────────────────────────────────────────────────────────────────
# flock — environment configuration
# Vars marked [REQUIRED] are enforced at boot (server.js); the server refuses to
# start if any are missing. Gupshup vars are optional — WhatsApp degrades
# gracefully and the queue still works without them.
# ─────────────────────────────────────────────────────────────────────────────

# Database — Supabase Postgres                                      [REQUIRED]
# Use the connection pooler URL (port 6543, transaction mode) for the app and
# append ?pgbouncer=true. Keep the direct URL (port 5432) only for migrations.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"

# Server
PORT=3000

# Auth — JWT signing secret (any long random string)               [REQUIRED]
JWT_SECRET="your-jwt-secret-here"

# OTP delivery — Resend (email login codes for venue owners)        [REQUIRED]
RESEND_API_KEY=""

# Payments — Razorpay subscriptions                                 [REQUIRED]
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# Storage — Supabase service role (menu PDF uploads)               [REQUIRED]
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# WhatsApp — Gupshup (BSP). Optional: if unset, WhatsApp sends are skipped.
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
GUPSHUP_SOURCE_NUMBER=""
GUPSHUP_WEBHOOK_SECRET=""
# Approved Gupshup template names
GUPSHUP_TEMPLATE_QUEUE_JOIN="queue_join_v2"
GUPSHUP_TEMPLATE_TABLE_READY=""

# Ops alerting — Pipedream (or any) HTTP webhook for failure pings. Optional.
OPS_ALERT_WEBHOOK_URL=""
